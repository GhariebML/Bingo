# Root-level example for local Docker Compose and deployment reference.
# Copy service-specific values into backend/.env or frontend/.env.local as needed.

# Local Docker Compose database.
POSTGRES_DB=bingo
POSTGRES_USER=bingo
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://bingo:change-me@localhost:5432/bingo

# Backend safety defaults. Keep mock AI enabled until external reviews are complete.
APP_ENV=production
AI_PROVIDER=mock
ENABLE_REAL_AI=false
CORS_ORIGINS=https://YOUR-VERCEL-FRONTEND-URL.vercel.app,http://localhost:3000
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none

# Frontend production defaults.
# Vercel must use the public Render backend URL, not localhost.
NEXT_PUBLIC_API_BASE_URL=https://bingo-backend-8dub.onrender.com
NEXT_PUBLIC_APP_MODE=demo
